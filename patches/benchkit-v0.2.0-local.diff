+class _CallTap:
+    """Read provider, usage, cost and timing out of a forwarded response.
+
+    Never changes what is forwarded; any parsing problem only loses the record.
+    """
+
+    def __init__(self, started: float, status: int) -> None:
+        self.record: dict = {"started": round(time.time(), 3), "status": status}
+        self.t0 = started
+        self.t_first_byte: float | None = None
+        self.t_first_token: float | None = None
+        self.t_last_token: float | None = None
+        self.buffer = b""
+        self.plain = b""
+
+    def feed(self, chunk: bytes) -> None:
+        now = time.monotonic()
+        if self.t_first_byte is None:
+            self.t_first_byte = now
+        self.buffer += chunk
+        if len(self.plain) < MAX_TAP_LINE:
+            self.plain += chunk[: MAX_TAP_LINE - len(self.plain)]
+        *lines, self.buffer = self.buffer.split(b"\n")
+        if len(self.buffer) > MAX_TAP_LINE:
+            self.buffer = b""
+        for line in lines:
+            if line.startswith(b"data: {"):
+                try:
+                    self._event(json.loads(line[6:]), now)
+                except (ValueError, TypeError, AttributeError):
+                    continue
+
+    def _event(self, event: dict, now: float) -> None:
+        if event.get("provider"):  # OpenRouter
+            self.record["provider"] = str(event["provider"])
+        if event.get("model"):
+            self.record.setdefault("model", str(event["model"]))
+        for choice in event.get("choices") or []:
+            delta = choice.get("delta") or choice.get("message") or {}
+            if any(
+                delta.get(key)
+                for key in ("content", "reasoning", "reasoning_content", "tool_calls")
+            ):
+                if self.t_first_token is None:
+                    self.t_first_token = now
+                self.t_last_token = now
+            if choice.get("finish_reason"):
+                self.record["finish_reason"] = str(choice["finish_reason"])
+            routing = ((delta.get("provider_metadata") or {}).get("gateway") or {}).get(
+                "routing"
+            ) or {}
+            if routing:  # Vercel AI Gateway
+                self.record["provider"] = str(
+                    routing.get("finalProvider") or routing.get("resolvedProvider")
+                )
+        usage = event.get("usage")
+        if isinstance(usage, dict):
+            details = usage.get("prompt_tokens_details") or {}
+            completion = usage.get("completion_tokens_details") or {}
+            self.record.update(
+                prompt_tokens=int(usage.get("prompt_tokens") or 0),
+                cached_tokens=int(details.get("cached_tokens") or 0),
+                cache_write_tokens=int(
+                    details.get("cache_write_tokens")
+                    or usage.get("cache_creation_input_tokens")
+                    or 0
+                ),
+                completion_tokens=int(usage.get("completion_tokens") or 0),
+                reasoning_tokens=int(completion.get("reasoning_tokens") or 0),
+            )
+            if usage.get("cost") is not None:
+                self.record["cost"] = float(usage["cost"])
+
+    def finish(self) -> None:
+        end = time.monotonic()
+        if "completion_tokens" not in self.record and self.plain.lstrip().startswith(
+            b"{"
+        ):
+            # non-streamed JSON response
+            with contextlib.suppress(ValueError, TypeError, AttributeError):
+                self._event(json.loads(self.plain), end)
+        rec = self.record
+        rec["total_s"] = round(end - self.t0, 3)
+        if self.t_first_byte is not None:
+            rec["ttfb_s"] = round(self.t_first_byte - self.t0, 3)
+        if self.t_first_token is not None:
+            rec["ttft_s"] = round(self.t_first_token - self.t0, 3)
+            span = (self.t_last_token or end) - self.t_first_token
+            tokens = rec.get("completion_tokens") or 0
+            if span > 0 and tokens:
+                rec["decode_tok_s"] = round(tokens / span, 1)
+        try:
+            with open(CALLS_PATH, "a", encoding="utf-8") as handle:
+                handle.write(json.dumps(rec) + "\n")
+        except OSError:
+            pass
